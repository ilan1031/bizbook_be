# Copy to .env for local development. On Render, add these under
# Environment (do not commit real values).

# --- Core ---
NODE_ENV=development
# Render sets PORT automatically; locally the server uses 4000.
PORT=4000
# MongoDB connection string (Atlas: Database > Connect > Drivers).
DB_Coll=mongodb+srv://<db-user>:<db-password>@<cluster-host>/bizbooks?retryWrites=true&w=majority
# Long random string used to sign login tokens (at least 16 characters).
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
# Frontend URL(s) allowed to call this API, comma-separated (no trailing slash).
FRONTEND_URL=http://localhost:3000
# Optional: host of the customer portal (/portal) if not FRONTEND_URL.
PORTAL_URL=
# Behind a proxy (Render): 1. Leave empty when running directly, otherwise
# clients could fake their IP address.
TRUST_PROXY=

# --- Superadmin (created/ensured on startup) ---
SUPERADMIN_EMAIL=admin@example.com
# Used only when the account is first created.
SUPERADMIN_PASSWORD=
# Optional: lets the superadmin sign in with a mobile number too.
SUPERADMIN_MOBILE=
# Set to true once to reset the superadmin password to SUPERADMIN_PASSWORD.
SUPERADMIN_RESET_PASSWORD=false

# --- Sign-in codes (sent by email) ---
LOGIN_OTP_ENABLED=true
# every_login (code on every sign-in, default) | new_device (only from a new IP)
LOGIN_OTP_MODE=every_login

# --- Email (Gmail: use an App Password) ---
# Sign-in codes, sign-up alerts to the superadmin and approval emails.
# EMAIL_PASS is a 16-letter Google App Password, not your Gmail password.
EMAIL_USER=
EMAIL_PASS=
# Optional: the From line, e.g. BizBooks <you@gmail.com>
EMAIL_FROM=
SMTP_USER=
SMTP_PASSWORD=

# --- Integrations ---
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
GEMINI_API_KEY=
INVOICE_VIEW_BASE_URL=

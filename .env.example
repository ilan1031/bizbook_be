# Copy to .env for local development. On Render, add these under
# Environment (do not commit real values).

# --- Core ---
NODE_ENV=development
# Render sets PORT automatically; locally the server uses 4000.
PORT=4000
# MongoDB connection string (Atlas: Database > Connect > Drivers).
DB_Coll=mongodb+srv://<db-user>:<db-password>@<cluster-host>/bizbooks?retryWrites=true&w=majority
# Long random string used to sign login tokens (at least 16 characters).
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
# Frontend URL(s) allowed to call this API, comma-separated (no trailing slash).
FRONTEND_URL=http://localhost:3000
# Behind a proxy (Render): 1. Leave empty when running directly, otherwise
# clients could fake their IP address.
TRUST_PROXY=

# --- Superadmin (created/ensured on startup) ---
SUPERADMIN_EMAIL=admin@example.com
# Used only when the account is first created.
SUPERADMIN_PASSWORD=
# Optional: receives an SMS when someone signs up.
SUPERADMIN_MOBILE=
# Set to true once to reset the superadmin password to SUPERADMIN_PASSWORD.
SUPERADMIN_RESET_PASSWORD=false

# --- SMS ---
# console (log only, default) | 2factor | fast2sms | twilio
SMS_PROVIDER=console
SMS_DEFAULT_COUNTRY_CODE=91
# Require an SMS code before a user's new IP address is approved.
# Only takes effect when an SMS provider is configured.
LOGIN_OTP_ENABLED=false
TWOFACTOR_API_KEY=
# Optional: an approved 2Factor OTP template name (else 2Factor's default)
TWOFACTOR_OTP_TEMPLATE=
FAST2SMS_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# --- Email (Gmail: use an App Password) ---
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=
SMTP_USER=
SMTP_PASSWORD=

# --- Integrations ---
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
GEMINI_API_KEY=
INVOICE_VIEW_BASE_URL=
